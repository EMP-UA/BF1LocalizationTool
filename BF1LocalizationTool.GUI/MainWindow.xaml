<Window x:Class="BF1LocalizationTool.GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="BF1 Localization Tool — EMP_UA"
        Height="720" Width="1200" MinHeight="520" MinWidth="860"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <!-- UA: Готові позначки для колонки "Вичитка" — той самий підхід, що
             й у SWH.LocEditor (MainWindow.xaml, ReviewPresets): випадають у
             списку, але поле РЕДАГОВАНЕ (ComboBox IsEditable), тож замість
             готової позначки можна вписати довільний коментар до рядка.
             EN: Ready-made markers for the "Review" column — same approach
             as SWH.LocEditor (MainWindow.xaml, ReviewPresets): offered in a
             dropdown, but the field is EDITABLE (ComboBox IsEditable), so a
             free-form per-row comment can be typed instead of a marker. -->
        <x:Array x:Key="ReviewPresets" Type="{x:Type sys:String}">
            <sys:String>+</sys:String>
            <sys:String>-</sys:String>
            <sys:String>+/-</sys:String>
        </x:Array>

        <!-- ══════════════════════════════════════════════════════════════
             UA: Кольорове кодування РЯДКА ЦІЛКОМ — за зразком SWH.LocEditor
             (MainWindow.xaml, стиль "RowStyle"): рядок отримує заливку
             ЦІЛКОМ + тонку рамку в тон, а не лише маленький кружечок у
             першій колонці ("●") плюс колір тексту перекладу —
             рядки, що потребують уваги, мають одразу кидатись в око.
             Порядок тригерів = ПРІОРИТЕТ (пізніший тригер ПЕРЕМАГАЄ,
             якщо кілька умов збігаються одночасно):
               Без перекладу (база) < Перекладено < Дублі з розбіжним
               перекладом < Проблема (задовгий/недійсний) < Технічний (не
               потребує перекладу взагалі) < Змінено й не збережено
               (найвищий — саме це користувачу треба зберегти НАЙПЕРШИМ).
             EN: Color-codes the WHOLE ROW — modeled after SWH.LocEditor
             (MainWindow.xaml, the "RowStyle" style): the row gets a full
             fill + a thin matching border, not just a small dot in the
             first column ("●") plus the translation text color — rows
             needing attention should immediately catch the eye. Trigger
             order = PRIORITY (a later trigger WINS if multiple conditions
             match at once):
               Untranslated (base) < Translated < Duplicates with
               inconsistent translation < Issue (too long/invalid) <
               Technical (doesn't need translation at all) <
               Modified-and-unsaved (highest — this is exactly what the
               user needs to save FIRST).
             ══════════════════════════════════════════════════════════════ -->
        <Style x:Key="RowStyle" TargetType="DataGridRow">
            <Setter Property="Background"      Value="{DynamicResource RowUntranslatedBg}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource UntranslatedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTranslated}" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource RowTranslatedBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource TranslatedBrush}"/>
                </DataTrigger>
                <!-- UA: Дублі з розбіжним перекладом — попередження нижчого
                     пріоритету за "Проблему" (задовгий/недійсний), яка
                     МАЄ перемагати, якщо застосовна одночасно.
                     EN: Duplicates with inconsistent translation — a
                     lower-priority warning than "Issue" (too long/
                     invalid), which MUST win if both apply at once. -->
                <DataTrigger Binding="{Binding HasInconsistentDuplicateTranslation}" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource RowDupWarnBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource RowIssueBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                </DataTrigger>
                <!-- UA: Технічний рядок — заливка БЕЗ рамки (BorderThickness=0
                     явно прибирає базову рамку), щоб не виглядало як
                     попередження — це нейтральна інформація, не проблема.
                     EN: Technical row — fill WITHOUT a border
                     (BorderThickness=0 explicitly removes the base border),
                     so it doesn't look like a warning — it's neutral
                     information, not a problem. -->
                <DataTrigger Binding="{Binding IsTechnical}" Value="True">
                    <Setter Property="Background"      Value="{DynamicResource RowTechnicalBg}"/>
                    <Setter Property="BorderThickness"  Value="0"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsModified}" Value="True">
                    <Setter Property="Background"  Value="{DynamicResource RowModifiedBg}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentLightBrush}"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBg}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ TOOLBAR ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- UA: Бренд-блок / EN: Brand block -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="⚡" Foreground="{StaticResource AccentLightBrush}"
                               FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <StackPanel>
                        <TextBlock Text="BF1 Localization Tool"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtBrandSub" Text="EMP_UA"
                                   Foreground="{StaticResource AccentLightBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                </StackPanel>

                <!-- UA: Дії / EN: Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnOpenOriginal" Style="{StaticResource EmpButton}"
                            Content="📂 UA: Оригінал / EN: Original"
                            ToolTip="UA: Файл-оригінал — READ-ONLY, ніколи не перезаписується, дає колонку 'Оригінал' / EN: Original file — READ-ONLY, never overwritten, provides the 'Original' column"
                            Click="BtnOpenOriginal_Click" Margin="0,0,6,0"/>
                    <Button x:Name="BtnNewWorking" Style="{StaticResource EmpButton}"
                            Content="✨ UA: Новий робочий / EN: New working"
                            ToolTip="UA: Клонувати оригінал у пам'яті як робочий файл — переклад 'з нуля' / EN: Clone the original in memory as the working file — translate 'from scratch'"
                            Click="BtnNewWorking_Click" Margin="0,0,6,0" IsEnabled="False"/>
                    <Button x:Name="BtnOpenWorking" Style="{StaticResource EmpButton}"
                            Content="📂 UA: Робочий файл / EN: Working file"
                            ToolTip="UA: Відкрити ІСНУЮЧИЙ робочий файл (напр. згенерований core.lvl з output-теки) — саме сюди пишеться переклад / EN: Open an EXISTING working file (e.g. the generated core.lvl from the output folder) — this is what the translation is written into"
                            Click="BtnOpenWorking_Click" Margin="0,0,6,0" IsEnabled="False"/>
                    <Button x:Name="BtnSave" Style="{StaticResource EmpButton}"
                            Content="💾 UA: Зберегти / EN: Save"
                            Click="BtnSave_Click" Margin="0,0,6,0" IsEnabled="False"/>
                    <Separator Width="1" Background="{StaticResource AccentPurpleBrush}" Margin="4,0"/>
                    <Button x:Name="BtnExportCsv" Style="{StaticResource EmpButton}"
                            Content="⬆ CSV"
                            ToolTip="UA: Експорт CSV для Gemini / EN: Export CSV for Gemini"
                            Click="BtnExportCsv_Click" Margin="6,0,6,0" IsEnabled="False"/>
                    <Button x:Name="BtnImportCsv" Style="{StaticResource EmpButton}"
                            Content="⬇ CSV"
                            ToolTip="UA: Імпорт CSV / EN: Import CSV"
                            Click="BtnImportCsv_Click" IsEnabled="False"/>
                    <Separator Width="1" Background="{StaticResource AccentPurpleBrush}" Margin="4,0"/>
                    <Button x:Name="BtnCompare" Style="{StaticResource EmpButton}"
                            Content="🔍 UA: Порівняти / EN: Compare"
                            ToolTip="UA: Порівняти два core.lvl за текстом (оригінал ↔ змінений) / EN: Compare two core.lvl files by text (original ↔ modified)"
                            Click="BtnCompare_Click" Margin="6,0,6,0"/>
                    <Separator Width="1" Background="{StaticResource AccentPurpleBrush}" Margin="4,0"/>
                    <Button x:Name="BtnTransferFromOtherGame" Style="{StaticResource EmpButton}"
                            Content="⇄ UA: BF1↔BF2 / EN: BF1↔BF2"
                            ToolTip="UA: Перенести переклад з іншої гри (напр. BF1 → BF2) за англійським оригіналом (без урахування регістру; регістр перекладу підлаштовується під рядок поточної гри) — питає ДВА файли донора (спершу ванільний, потім перекладений), не чіпає ВИЧИТАНІ (ReviewStatus) рядки, решту (в т.ч. вже перекладені Gemini) може перезаписати. Структура й шрифти завжди з поточного файлу / EN: Transfer translation from another game (e.g. BF1 → BF2) by matching English original (case-insensitive; the translation's case is adapted to the current game's row) — asks for TWO donor files (vanilla first, then translated), leaves REVIEWED (ReviewStatus) rows untouched, may overwrite the rest (including rows already translated by Gemini). Structure and fonts always stay from the current file"
                            Click="BtnTransferFromOtherGame_Click" Margin="6,0,0,0" IsEnabled="False"/>
                </StackPanel>

                <!-- UA: Права панель — тема, шрифт / EN: Right panel — theme, font -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BtnTheme" Style="{StaticResource EmpButtonSmall}"
                            Content="☾ UA: Темна / EN: Dark"
                            Click="BtnTheme_Click" Margin="0,0,6,0"/>
                    <Button Style="{StaticResource EmpButtonSmall}" Content="A-"
                            Click="BtnFontDecrease_Click" Margin="0,0,3,0"/>
                    <Button Style="{StaticResource EmpButtonSmall}" Content="A+"
                            Click="BtnFontIncrease_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ МОВНІ СЕЛЕКТОРИ ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1" Background="{DynamicResource BgWindowBrush}" Padding="8,5">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="UA: Оригінал / EN: Source:"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbSourceLang" Width="140" Height="28"
                          SelectionChanged="CmbSourceLang_SelectionChanged" IsEnabled="False"/>

                <TextBlock Text="UA: Переклад / EN: Target:"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,6,0"/>
                <ComboBox x:Name="CmbTargetLang" Width="140" Height="28"
                          SelectionChanged="CmbTargetLang_SelectionChanged" IsEnabled="False"/>

                <Separator Width="1" Background="{StaticResource AccentPurpleBrush}" Margin="12,2"/>

                <Button x:Name="BtnCopySourceToTarget" Style="{StaticResource EmpButtonSmall}"
                        Content="UA: ↓ Скопіювати рядок / EN: ↓ Copy row"
                        Click="BtnCopySourceToTarget_Click" IsEnabled="False" Margin="6,0,6,0"/>
                <Button x:Name="BtnMarkTechnical" Style="{StaticResource EmpButtonSmall}"
                        Content="⚙ UA: Техн. / EN: Tech."
                        Click="BtnMarkTechnical_Click" IsEnabled="False" Margin="0,0,6,0"/>
                <Button x:Name="BtnAutoMarkTechnical" Style="{StaticResource EmpButtonSmall}"
                        Content="⚙⚙ UA: Авто-техн. / EN: Auto-tech."
                        Click="BtnAutoMarkTechnical_Click" IsEnabled="False"/>

                <TextBlock x:Name="TxtValidationWarnings"
                           Foreground="{StaticResource WarningBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                           Visibility="Collapsed"/>
            </WrapPanel>
        </Border>

        <!-- ══ ФІЛЬТРИ + ЛІЧИЛЬНИК ═══════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" Padding="8,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Grid.Column="1" x:Name="TxtSearch" Height="26"
                         TextChanged="TxtSearch_TextChanged"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="12,0,0,0">
                    <RadioButton x:Name="RbAll" IsChecked="True"
                                 Content="UA: Усі / EN: All" Checked="FilterChanged"/>
                    <RadioButton x:Name="RbUntranslated"
                                 Content="UA: Без пер. / EN: Untranslated"
                                 Foreground="{StaticResource UntranslatedBrush}"
                                 Checked="FilterChanged"/>
                    <RadioButton x:Name="RbTranslated"
                                 Content="UA: Перекл. / EN: Translated"
                                 Foreground="{StaticResource TranslatedBrush}"
                                 Checked="FilterChanged"/>
                    <RadioButton x:Name="RbTechnical"
                                 Content="⚙ UA: Техн. / EN: Technical"
                                 Foreground="{DynamicResource TechnicalBrush}"
                                 Checked="FilterChanged"/>
                    <RadioButton x:Name="RbInvalid"
                                 Content="⚠ UA: Проблемні / EN: Issues"
                                 Foreground="{StaticResource WarningBrush}"
                                 Checked="FilterChanged"/>
                </StackPanel>

                <TextBlock Grid.Column="3" x:Name="TxtFilterCount"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ══ ТАБЛИЦЯ ════════════════════════════════════════════════════════════════ -->
        <DataGrid Grid.Row="3" x:Name="GridEntries"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeaderWidth="0"
                  IsReadOnly="False"
                  RowStyle="{StaticResource RowStyle}"
                  CellEditEnding="GridEntries_CellEditEnding"
                  SelectionChanged="GridEntries_SelectionChanged"
                  PreviewMouseRightButtonDown="GridEntries_PreviewMouseRightButtonDown">

            <!-- UA: Контекстне меню рядка / EN: Row context menu -->
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="UA: Копіювати оригінал / EN: Copy original"
                              Click="CtxCopyOriginal_Click"/>
                    <MenuItem Header="UA: Вставити оригінал як переклад / EN: Paste original as translation"
                              Click="CtxPasteAsTranslation_Click"/>
                    <MenuItem Header="UA: Очистити переклад / EN: Clear translation"
                              Click="CtxClearTranslation_Click"/>
                    <MenuItem Header="⧉ UA: Застосувати переклад до всіх дублів / EN: Apply translation to all duplicates"
                              ToolTip="UA: Копіює переклад цього рядка в усі рядки з ІДЕНТИЧНИМ оригіналом / EN: Copies this row's translation into every row with an IDENTICAL original"
                              Click="CtxApplyToDuplicates_Click"/>
                    <Separator/>
                    <MenuItem Header="UA: Копіювати хеш / EN: Copy hash"
                              Click="CtxCopyHash_Click"/>
                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <!-- Статус -->
                <DataGridTemplateColumn Header="●" Width="24" IsReadOnly="True" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="8" Height="8" Margin="4,0"
                                     Fill="{Binding StatusColor}"
                                     VerticalAlignment="Center"
                                     ToolTip="{Binding StatusTooltip}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Hash -->
                <DataGridTextColumn Header="Hash" Binding="{Binding HashDisplay}"
                                    Width="110" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize"   Value="12"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"    Value="4,2"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Оригінал -->
                <DataGridTextColumn Header="UA: Оригінал / EN: Original (read-only)"
                                    Binding="{Binding Original}" Width="2*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Padding"    Value="4,2"/>
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Дублі — за зразком SWH.LocEditor ("⧉ Дублі/Dup." колонка):
                     показує розмір групи ЛИШЕ для рядків, у яких оригінал
                     збігається з іншим (мінімум) одним рядком. Технічні —
                     виключено (див. MainWindow.RecomputeDuplicates). Колір
                     тексту синхронізовано з кольором рамки "розбіжного
                     дубля" в RowStyle (AccentPurpleBrush), щоб бейдж і
                     попередження рядка виглядали як одна система. -->
                <!-- Duplicates — modeled after SWH.LocEditor (the
                     "⧉ Дублі/Dup." column): shows the group size ONLY for
                     rows whose original matches at least one other row.
                     Technical rows excluded (see
                     MainWindow.RecomputeDuplicates). Text color matches the
                     "inconsistent duplicate" border color in RowStyle
                     (AccentPurpleBrush), so the badge and the row warning
                     read as one system. -->
                <DataGridTemplateColumn Header="⧉" Width="28" IsReadOnly="True" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DuplicateGroupSize}"
                                       FontWeight="Bold" FontSize="11"
                                       Foreground="{StaticResource AccentPurpleBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="{Binding IsDuplicateOriginal, Converter={StaticResource BoolToVisibility}}"
                                       ToolTip="UA: Стільки рядків мають ІДЕНТИЧНИЙ оригінал (технічні не рахуються). Фіолетовий фон рядка = серед них є розбіжний переклад — ПКМ → 'Застосувати переклад до всіх дублів' / EN: This many rows share an IDENTICAL original (technical rows not counted). A purple row background = one of them has a different translation — right-click → 'Apply translation to all duplicates'"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Переклад — DataGridTemplateColumn для відображення технічних рядків.
                     SortMemberPath ОБОВ'ЯЗКОВИЙ: TemplateColumn без нього не сортується
                     кліком по заголовку (на відміну від TextColumn, де сортування "з коробки").
                     UA: Колір тексту за статусом (перекладено/не перекладено) прибрано —
                     тепер за це відповідає заливка ЦІЛОГО РЯДКА (RowStyle вище), а тут
                     лишається лише нейтральний TextPrimaryBrush + виділення технічних
                     рядків курсивом/жирним (за зразком SWH.LocEditor, де так само після
                     появи RowStyle прибрано дублювання кольору в тексті колонки перекладу).
                     EN: Per-status text color (translated/untranslated) removed — that's
                     now the job of the WHOLE-ROW fill (RowStyle above); this column keeps
                     only a neutral TextPrimaryBrush plus italic/bold for technical rows
                     (modeled after SWH.LocEditor, which likewise dropped the duplicate
                     text-color signal from the translation column once RowStyle existed). -->
                <DataGridTemplateColumn x:Name="ColTranslation" Header="UA: Переклад / EN: Translation" Width="2*"
                                         SortMemberPath="Translation">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TranslationDisplay}"
                                       TextWrapping="Wrap" Padding="4,2"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                        <Style.Triggers>
                                            <!-- UA: Технічний — найвищий пріоритет, йде останнім щоб перебити все -->
                                            <!-- EN: Technical — highest priority, placed last to override everything -->
                                            <DataTrigger Binding="{Binding IsTechnical}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TechnicalBrush}"/>
                                                <Setter Property="FontStyle" Value="Italic"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Translation, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource BgRowAltBrush}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderThickness="0" Padding="4,2"
                                     AcceptsReturn="False"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Статус вичитки — той самий підхід, що й у SWH.LocEditor
                     (MainWindow.xaml, ReviewPresets/колонка "Вичитка"):
                     подвійний клік відкриває РЕДАГОВАНИЙ ComboBox із трьома
                     готовими позначками (+, -, +/-), але можна й вписати
                     власний коментар до конкретного рядка. ЛИШЕ GUI-
                     метадані: НІКОЛИ не пишеться в core.lvl, лише в парний
                     робочий CSV поруч зі збереженням (див.
                     MainWindow.EntryRow.ReviewStatus / BtnSave_Click).
                     SortMemberPath ОБОВ'ЯЗКОВИЙ — той самий принцип, що й
                     для колонки "Переклад" вище (TemplateColumn без нього
                     не сортується кліком по заголовку). -->
                <DataGridTemplateColumn Header="UA: Вичитка / EN: Review" Width="90"
                                         SortMemberPath="ReviewStatus">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ReviewStatus}" TextWrapping="Wrap"
                                       Padding="4,2" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="UA: Подвійний клік — обрати позначку (+, -, +/-) або вписати власний коментар до рядка / EN: Double-click — pick a marker (+, -, +/-) or type your own per-row comment"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True"
                                      ItemsSource="{StaticResource ReviewPresets}"
                                      Text="{Binding ReviewStatus, UpdateSourceTrigger=PropertyChanged}"
                                      Background="{DynamicResource BgRowAltBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Попередження -->
                <DataGridTemplateColumn Header="⚠" Width="24" IsReadOnly="True" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="⚠" FontSize="12"
                                       Foreground="{StaticResource WarningBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       ToolTip="{Binding ValidationMessage}"
                                       Visibility="{Binding HasValidationError,
                                           Converter={StaticResource BoolToVisibility}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <!-- UA: Технічні рядки тепер ТЕЖ мають фон рядка (RowTechnicalBg,
                 див. RowStyle вище) плюс текст курсивом/жирним у колонці
                 перекладу — фон більше не "хардкоджений", а йде через
                 DynamicResource і міняється разом з темою (ApplyTheme). -->
            <!-- EN: Technical rows now ALSO get a row background
                 (RowTechnicalBg, see RowStyle above) plus italic/bold text
                 in the translation column — the background is no longer
                 "hardcoded", it goes through DynamicResource and changes
                 with the theme (ApplyTheme). -->
        </DataGrid>

        <!-- ══ STATUS BAR ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="4" Background="{DynamicResource BgPanelBrush}" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtStatus" Grid.Column="0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center"
                           Text="UA: Відкрийте core.lvl для початку / EN: Open core.lvl to start"
                           TextTrimming="CharacterEllipsis"/>

                <!-- UA: Налаштування порогу "задовгого" перекладу (падає в Проблемні).
                     Окремого меню налаштувань у GUI ще не було — додано тут,
                     поруч зі статусом автозбереження. -->
                <!-- EN: "Too long translation" threshold settings (flags into Issues).
                     There was no dedicated settings menu in the GUI yet — added
                     here, next to the autosave status. -->
                <Button x:Name="BtnLengthSettings" Grid.Column="1"
                        Content="⚙" Width="22" Height="22" Margin="8,0,0,0"
                        Padding="0" FontSize="12"
                        ToolTip="UA: Поріг довжини перекладу / EN: Translation length threshold"
                        Click="BtnLengthSettings_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Popup x:Name="PopupLengthSettings" PlacementTarget="{Binding ElementName=BtnLengthSettings}"
                       Placement="Top" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{DynamicResource BgPanelBrush}"
                            BorderBrush="{DynamicResource TechnicalBrush}" BorderThickness="1"
                            Padding="10" CornerRadius="4">
                        <StackPanel Width="280">
                            <TextBlock Text="UA: Поріг довжини перекладу — переклад &gt; оригінал×коеф.+запас падає в «Проблемні» / EN: Translation length threshold — translation &gt; original×ratio+margin flags into «Issues»"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                           Text="UA: Коефіцієнт (×оригінал) / EN: Ratio (×original)"/>
                                <TextBox x:Name="TxtLengthRatio" Grid.Column="1" Text="1.3"
                                         TextChanged="LengthThreshold_Changed"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                           Text="UA: Запас (символів) / EN: Margin (chars)"/>
                                <TextBox x:Name="TxtLengthMargin" Grid.Column="1" Text="4"
                                         TextChanged="LengthThreshold_Changed"/>
                            </Grid>
                            <TextBlock x:Name="TxtLengthPreview" FontSize="10" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TechnicalBrush}"/>
                        </StackPanel>
                    </Border>
                </Popup>

                <TextBlock x:Name="TxtAutoSaveStatus" Grid.Column="2"
                           Foreground="{DynamicResource TechnicalBrush}"
                           FontSize="11" VerticalAlignment="Center" Margin="12,0"/>

                <!-- UA: Лічильник: перекладено/всього (%) · правок · техн. · проблем -->
                <!-- EN: Counter: translated/total (%) · edits · tech. · issues -->
                <TextBlock x:Name="TxtProgress" Grid.Column="3"
                           Foreground="{StaticResource AccentLightBrush}"
                           FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
        </Border>

    </Grid>
</Window>
