<Window x:Class="BF1LocalizationTool.GUI.TranslationConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UA: Конфлікти перекладу — перенесення з іншої гри / EN: Translation Conflicts — cross-game transfer"
        Height="620" Width="1000" MinHeight="360" MinWidth="640"
        Background="{DynamicResource BgWindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ ПОЯСНЕННЯ ════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanelBrush}" Padding="10,8">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <Run Text="UA: Для цих англійських рядків у донорі знайдено ДЕКІЛЬКА різних українських перекладів (різні контексти в межах гри-донора) — оберіть варіант для кожного, або залиште «— пропустити —», щоб не переносити переклад."/>
                    <LineBreak/>
                    <Run Text="EN: SEVERAL different Ukrainian translations were found in the donor for these English strings (different contexts within the donor game) — pick a variant for each, or leave «— skip —» to not transfer that translation."/>
                </TextBlock>
                <TextBlock x:Name="TxtSummary" Margin="0,6,0,0" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- ══ ТАБЛИЦЯ КОНФЛІКТІВ ═══════════════════════════════════════════════════ -->
        <!-- UA: RowBackground/AlternatingRowBackground задано локально — те саме
             обґрунтування, що й у CompareWindow.xaml (це вікно теж без власного
             RowStyle).
             EN: RowBackground/AlternatingRowBackground set locally — same
             rationale as in CompareWindow.xaml (this window also has no
             RowStyle of its own). -->
        <DataGrid Grid.Row="1" x:Name="GridConflicts"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeaderWidth="0" HeadersVisibility="Column"
                  RowBackground="{DynamicResource BgPanelBrush}"
                  AlternatingRowBackground="{DynamicResource BgRowAltBrush}">
            <DataGrid.Columns>

                <DataGridTextColumn Header="UA: Англійський оригінал / EN: English original"
                                     Binding="{Binding Original}" Width="2*" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="Padding"      Value="4,4"/>
                            <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="UA: Обрати переклад / EN: Choose translation" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding Options}"
                                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                                      Margin="2" Padding="4,3"
                                      HorizontalContentAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="380"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- ══ КНОПКИ ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{DynamicResource BgPanelBrush}" Padding="10,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSkipAll" Style="{StaticResource EmpButton}"
                        Content="UA: Пропустити всі / EN: Skip all"
                        Click="BtnSkipAll_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnCancel" Style="{StaticResource EmpButton}"
                        Content="UA: Скасувати / EN: Cancel"
                        Click="BtnCancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="BtnApply" Style="{StaticResource EmpButton}"
                        Content="✓ UA: Застосувати / EN: Apply"
                        Click="BtnApply_Click"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
