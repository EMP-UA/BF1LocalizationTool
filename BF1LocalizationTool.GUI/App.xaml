<Application x:Class="BF1LocalizationTool.GUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ═══ ПЕНЗЛІ ТЕМИ (замінюються цілком в коді через ApplyTheme) ══════════ -->
        <!-- ═══ THEME BRUSHES (replaced entirely in code via ApplyTheme) ═════════ -->
        <SolidColorBrush x:Key="BgWindowBrush"      Color="#0D0A14"/>
        <SolidColorBrush x:Key="BgPanelBrush"       Color="#1A1525"/>
        <SolidColorBrush x:Key="BgRowAltBrush"      Color="#221C30"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E8E0F0"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9080A8"/>

        <!-- ═══ НЕЗМІННІ АКЦЕНТНІ КОЛЬОРИ ═══════════════════════════════════════ -->
        <SolidColorBrush x:Key="AccentPurpleBrush" Color="#8A46C1"/>
        <SolidColorBrush x:Key="AccentLightBrush"  Color="#C989F3"/>
        <SolidColorBrush x:Key="TranslatedBrush"   Color="#4CAF7D"/>
        <SolidColorBrush x:Key="UntranslatedBrush" Color="#CF6679"/>
        <SolidColorBrush x:Key="TechnicalBrush"    Color="#7A9EB5"/>
        <SolidColorBrush x:Key="WarningBrush"      Color="#E6A832"/>

        <!-- ═══ КОНВЕРТЕРИ ═══════════════════════════════════════════════════════ -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ═══ КНОПКИ ═══════════════════════════════════════════════════════════ -->
        <Style x:Key="EmpButton" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,5"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{StaticResource AccentLightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="EmpButtonSmall" TargetType="Button"
               BasedOn="{StaticResource EmpButton}">
            <Setter Property="Padding"  Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ═══ COMBOBOX ═════════════════════════════════════════════════════════ -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource BgPanelBrush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="6,3,24,3" VerticalAlignment="Center"
                                              TextBlock.Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <ToggleButton HorizontalAlignment="Right" Width="20"
                                          Background="Transparent" BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <Path Data="M0,0 L4,4 L8,0 Z"
                                      Fill="{StaticResource AccentLightBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </ToggleButton>
                            <Popup Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid MinWidth="{TemplateBinding ActualWidth}" MaxHeight="300">
                                    <Border Background="{DynamicResource BgPanelBrush}"
                                            BorderBrush="{StaticResource AccentPurpleBrush}"
                                            BorderThickness="1"/>
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Padding"    Value="6,3"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background"
                            Value="{StaticResource AccentPurpleBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ DATAGRID ════════════════════════════════════════════════════════ -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"
                    Value="{DynamicResource BgPanelBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="GridLinesVisibility"      Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"
                    Value="{DynamicResource BgWindowBrush}"/>
            <Setter Property="RowBackground"
                    Value="{DynamicResource BgPanelBrush}"/>
            <Setter Property="AlternatingRowBackground"
                    Value="{DynamicResource BgRowAltBrush}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="SelectionMode"   Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth"  Value="0"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"
                    Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BgWindowBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <!-- ═══ RADIOBUTTON ═════════════════════════════════════════════════════ -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"
                    Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin"   Value="0,0,10,0"/>
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground"
                            Value="{StaticResource AccentLightBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ═══ TEXTBOX ═════════════════════════════════════════════════════════ -->
        <Style TargetType="TextBox">
            <Setter Property="Background"
                    Value="{DynamicResource BgPanelBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{StaticResource AccentPurpleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CaretBrush"
                    Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding"  Value="6,2"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

    </Application.Resources>
</Application>
