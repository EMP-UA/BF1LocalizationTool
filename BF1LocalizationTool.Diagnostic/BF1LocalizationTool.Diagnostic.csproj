<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>BF1Diagnostic</AssemblyName>
		<RootNamespace>BF1LocalizationTool.Diagnostic</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\BF1LocalizationTool.Core\BF1LocalizationTool.Core.csproj" />
		<ProjectReference Include="..\BF1LocalizationTool.FontGenerator\BF1LocalizationTool.FontGenerator.csproj" />
	</ItemGroup>

	<!--
	UA: PrivateFontRegistry читає шрифти з AppContext.BaseDirectory\Fonts\ —
	    це тека РЕЗУЛЬТАТУ збірки (bin\Debug\net10.0-windows\Fonts\), а НЕ
	    тека проєкту (BF1LocalizationTool.Diagnostic\Fonts\), де фізично
	    лежать .ttf. Fonts\ лежить біля .csproj, але сам .ttf-вміст НЕ в
	    git (.gitignore) — кожен розробник/користувач завантажує потрібні
	    файли самостійно з Google Fonts (README, розділ "Кирилиця в
	    .txt-каналі"; §7.6 FONT_FORMAT_SPEC.md) і кладе в цю теку.
	    CopyToOutputDirectory — стандартний MSBuild-міст: копіює .ttf у
	    bin\ ПІСЛЯ кожної збірки, автоматично, рекурсивно. Diagnostic —
	    інструмент аналізу/генерації, що розповсюджується лише як вихідний
	    код (запуск через `dotnet run`/`dotnet build`), у готовий реліз-
	    архів не входить — там лише скомпільований GUI-редактор.
	EN: PrivateFontRegistry reads fonts from AppContext.BaseDirectory\Fonts\
	    — the BUILD OUTPUT folder (bin\Debug\net10.0-windows\Fonts\), NOT
	    the project folder (BF1LocalizationTool.Diagnostic\Fonts\) where the
	    .ttf files physically live. Fonts\ lives next to the .csproj, but
	    its .ttf contents are NOT in git (.gitignore) — each developer/user
	    downloads the needed files themselves from Google Fonts (README,
	    "Cyrillic in the .txt channel" section; FONT_FORMAT_SPEC.md §7.6)
	    and places them in this folder. CopyToOutputDirectory is the
	    standard MSBuild bridge: copies the .ttf files into bin\ after
	    every build, automatically, recursively. Diagnostic is an analysis/
	    generation tool distributed as source only (run via `dotnet run`/
	    `dotnet build`) — it is not part of the compiled release archive,
	    which contains only the GUI editor.
	-->
	<ItemGroup>
		<None Include="Fonts\**\*.ttf" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>